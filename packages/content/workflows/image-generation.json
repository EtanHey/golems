{
  "name": "Content: Image Generation",
  "nodes": [
    {
      "parameters": {
        "updates": {
          "update": [
            {
              "chatId": "={{ $json.message.chat.id }}",
              "text": "Generating image... This may take 5-15 minutes."
            }
          ]
        }
      },
      "id": "send-wait-msg",
      "name": "Send Wait Message",
      "type": "n8n-nodes-base.telegram",
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/comfyui/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.parsed_prompt }}"
            },
            {
              "name": "style",
              "value": "={{ $json.parsed_style || 'base' }}"
            },
            {
              "name": "quality",
              "value": "={{ $json.parsed_quality || 'social' }}"
            }
          ]
        },
        "options": {
          "timeout": 900000
        }
      },
      "id": "generate-image",
      "name": "Generate via ComfyUI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [660, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.qualityPassed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "quality-check",
      "name": "Quality Gate",
      "type": "n8n-nodes-base.if",
      "position": [860, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "additionalFields": {
          "caption": "Quality: PASS\n{{ $json.scoreSummary }}\nDuration: {{ Math.round($json.durationMs / 1000) }}s\nAttempts: {{ $json.attempts }}"
        }
      },
      "id": "send-result",
      "name": "Send Result to Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [1060, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Image generated but quality gates failed:\n{{ $json.scoreSummary }}\n\nSending best result anyway."
      },
      "id": "send-warning",
      "name": "Send Quality Warning",
      "type": "n8n-nodes-base.telegram",
      "position": [1060, 400]
    }
  ],
  "connections": {
    "Send Wait Message": {
      "main": [
        [{ "node": "Generate via ComfyUI", "type": "main", "index": 0 }]
      ]
    },
    "Generate via ComfyUI": {
      "main": [
        [{ "node": "Quality Gate", "type": "main", "index": 0 }]
      ]
    },
    "Quality Gate": {
      "main": [
        [{ "node": "Send Result to Telegram", "type": "main", "index": 0 }],
        [{ "node": "Send Quality Warning", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionTimeout": -1
  },
  "tags": ["content", "image-generation"]
}
