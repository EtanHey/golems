{
  "name": "Content: Image Generation",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/comfyui/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.parsed_prompt }}"
            },
            {
              "name": "style",
              "value": "={{ $json.parsed_style || 'base' }}"
            },
            {
              "name": "quality",
              "value": "={{ $json.parsed_quality || 'social' }}"
            }
          ]
        },
        "options": {
          "timeout": 900000
        }
      },
      "id": "generate-image",
      "name": "Generate via ComfyUI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [660, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.qualityPassed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "quality-check",
      "name": "Quality Gate",
      "type": "n8n-nodes-base.if",
      "position": [860, 300]
    }
  ],
  "connections": {
    "Generate via ComfyUI": {
      "main": [
        [
          {
            "node": "Quality Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quality Gate": {
      "main": [
        [],
        []
      ]
    }
  },
  "settings": {
    "executionTimeout": -1
  },
  "tags": ["content", "image-generation"]
}
