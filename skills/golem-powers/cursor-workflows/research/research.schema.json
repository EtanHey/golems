{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golems.local/cursor-workflows/quick-deep-research.schema.json",
  "title": "QuickDeepResearch",
  "type": "object",
  "definitions": {
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["source", "entity", "claim"] },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "type", "evidence"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "type": { "type": "string", "enum": ["supports", "contradicts", "mentions"] },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "claimVerdict": {
      "type": "object",
      "required": ["claim_id", "verdicts"],
      "properties": {
        "claim_id": { "type": "string" },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source_id", "verdict", "rationale", "anchor"],
            "properties": {
              "id": { "type": "string" },
              "source_id": { "type": "string" },
              "verdict": { "type": "string", "enum": ["supports", "contradicts", "unclear"] },
              "rationale": { "type": "string" },
              "anchor": { "type": "string" }
            }
          }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["report", "claim_citations"],
      "properties": {
        "report": { "type": "string" },
        "claim_citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "source_ids"],
            "properties": {
              "claim_id": { "type": "string" },
              "source_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
