{
  "specimen": "registry/unregistered-armed-monitor",
  "label": "RED - monitor is armed on the active channel but absent from registry heartbeat ground truth",
  "expect": "FLAG",
  "violation": "MONITOR_STALE_HEARTBEAT",
  "monitorRegistry": {
    "nowMs": 200000,
    "heartbeatWindowMs": 30000,
    "monitors": []
  },
  "events": [
    { "role": "user", "text": "Lead the unregistered monitor sprint." },
    {
      "role": "assistant",
      "text": "Arming monitor=mon-unregistered on the active channel and dispatching.",
      "tools": [
        {
          "name": "Monitor",
          "input": {
            "id": "mon-unregistered",
            "path": "collab/2026-07-02-unregistered.md",
            "pattern": "^### |ORC-RECEIPT:|@unregistered|BLOCKED",
            "persistent": true
          }
        },
        {
          "name": "mcp__cmux__spawn_agent",
          "input": { "cli": "codex", "repo": "golems" }
        },
        {
          "name": "Edit",
          "input": {
            "file_path": "collab/2026-07-02-unregistered.md",
            "old_string": "x",
            "new_string": "ORC-RECEIPT: kickoff"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "text": "monitor=mon-unregistered is armed. Standing by."
    }
  ]
}
