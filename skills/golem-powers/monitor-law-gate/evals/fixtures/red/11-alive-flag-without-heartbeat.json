{
  "specimen": "registry/alive-flag-without-heartbeat",
  "label": "RED - registry alive flag without heartbeat freshness is not liveness proof",
  "expect": "FLAG",
  "violation": "MONITOR_STALE_HEARTBEAT",
  "monitorRegistry": {
    "nowMs": 200000,
    "heartbeatWindowMs": 30000,
    "monitors": [
      {
        "id": "mon-claimed-alive",
        "path": "collab/2026-07-02-claimed-alive.md",
        "pattern": "^### |ORC-RECEIPT:|@claimedAlive|BLOCKED",
        "persistent": true,
        "alive": true
      }
    ]
  },
  "events": [
    { "role": "user", "text": "Lead the claimed-alive sprint." },
    {
      "role": "assistant",
      "text": "Arming monitor=mon-claimed-alive on the active channel and dispatching.",
      "tools": [
        {
          "name": "Monitor",
          "input": {
            "id": "mon-claimed-alive",
            "path": "collab/2026-07-02-claimed-alive.md",
            "pattern": "^### |ORC-RECEIPT:|@claimedAlive|BLOCKED",
            "persistent": true
          }
        },
        {
          "name": "mcp__cmux__spawn_agent",
          "input": { "cli": "codex", "repo": "golems" }
        },
        {
          "name": "Edit",
          "input": {
            "file_path": "collab/2026-07-02-claimed-alive.md",
            "old_string": "x",
            "new_string": "ORC-RECEIPT: kickoff"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "text": "monitor=mon-claimed-alive is alive. Standing by."
    }
  ]
}
