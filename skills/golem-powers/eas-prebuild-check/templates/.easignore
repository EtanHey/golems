# Canonical .easignore template
# Prevents the 2GB archive problem (TaskOwl Sprint 2, April 8 2026)
#
# This file tells EAS Build which paths to exclude from the archive uploaded
# to the EAS build workers. Anything not excluded ends up in the tarball.
#
# Rule of thumb: anything regenerable on a fresh clone + `npm install` +
# `expo prebuild` should be excluded here.

# ──────────────────────────────────────────────────────────────
# JavaScript / Node
# ──────────────────────────────────────────────────────────────
node_modules/
.yarn/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────────────────────────────────────
# Expo
# ──────────────────────────────────────────────────────────────
.expo/
.expo-shared/
expo-env.d.ts
dist/
web-build/

# ──────────────────────────────────────────────────────────────
# iOS (native build artifacts — regenerated by prebuild/xcodebuild)
# ──────────────────────────────────────────────────────────────
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/.xcode.env.local

# ──────────────────────────────────────────────────────────────
# Android (native build artifacts — regenerated by gradle)
# ──────────────────────────────────────────────────────────────
android/build/
android/.gradle/
android/app/build/
android/app/release/
android/captures/
android/gradle/
android/gradlew
android/gradlew.bat
android/local.properties
android/.idea/

# ──────────────────────────────────────────────────────────────
# Git / VCS
# ──────────────────────────────────────────────────────────────
.git/
.gitignore

# ──────────────────────────────────────────────────────────────
# IDE / editor
# ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# ──────────────────────────────────────────────────────────────
# Tests, docs, local scratch (not needed by build)
# ──────────────────────────────────────────────────────────────
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
tests/
docs/
docs.local/
README.md
CLAUDE.md
*.md

# ──────────────────────────────────────────────────────────────
# Secrets (EAS injects secrets via dashboard, not files)
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
credentials.json
*.p8
*.p12
*.mobileprovision
*.cer

# ──────────────────────────────────────────────────────────────
# Misc temp
# ──────────────────────────────────────────────────────────────
*.tsbuildinfo
coverage/
.nyc_output/
.cache/
tmp/
temp/
