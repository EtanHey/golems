<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.hardened</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOOGLE_API_KEY</key>
		<string>op://Private/google/api_key</string>
