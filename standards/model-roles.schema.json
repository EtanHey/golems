{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golems.dev/standards/model-roles.schema.json",
  "title": "Model roles",
  "type": "object",
  "required": ["schema", "roles"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "integer", "enum": [1]},
    "updated": {"type": "string"},
    "swap_rule": {"type": "string"},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["model", "use_for"],
        "additionalProperties": false,
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "alias": {"type": "string", "minLength": 1},
          "effort": {"type": "string", "minLength": 1},
          "effort_note": {"type": "string", "minLength": 1},
          "use_for": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "never_for": {"type": "string", "minLength": 1},
          "gate": {"type": "string", "minLength": 1},
          "launcher_tier": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["candidate", "active"], "default": "active"}
        }
      }
    },
    "_note": {"type": "string"}
  }
}
