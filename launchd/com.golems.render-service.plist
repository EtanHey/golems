<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golems.render-service</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.bun/bin/bun</string>
        <string>@GOLEMS_ROOT@/packages/orchestrator/src/render-service.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@GOLEMS_ROOT@/packages/orchestrator</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:@HOME@/.bun/bin</string>
        <key>RENDER_SERVICE_PORT</key>
        <string>3001</string>
    </dict>

    <!-- Start on demand, not at login -->
    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>@HOME@/.golems-zikaron/logs/render-service.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.golems-zikaron/logs/render-service.log</string>
</dict>
</plist>
