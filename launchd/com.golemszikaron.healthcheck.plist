<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golemszikaron.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.bun/bin/bun</string>
        <string>run</string>
        <string>@GOLEMS_ROOT@/packages/services/src/healthcheck.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@GOLEMS_ROOT@</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/golemszikaron-healthcheck.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/golemszikaron-healthcheck.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@HOME@/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
