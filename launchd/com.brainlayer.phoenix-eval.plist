<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brainlayer.phoenix-eval</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>@GOLEMS_ROOT@/skills/golem-powers/skill-creator/scripts/cmux_capture_batch.py</string>
        <string>--since-last</string>
        <string>--push</string>
        <string>--idle-min</string>
        <string>10</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>WorkingDirectory</key>
    <string>@GOLEMS_ROOT@</string>

    <key>StandardOutPath</key>
    <string>@HOME@/.local/share/brainlayer/logs/phoenix-eval.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/.local/share/brainlayer/logs/phoenix-eval.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/.bun/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>Nice</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
