<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.golems.worktree-gc</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@GOLEMS_ROOT@/scripts/worktree-gc.sh</string>
		<string>--apply</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>@GOLEMS_ROOT@/docs.local/worktree-gc-launchd.log</string>
	<key>StandardOutPath</key>
	<string>@GOLEMS_ROOT@/docs.local/worktree-gc-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>@GOLEMS_ROOT@</string>
</dict>
</plist>
