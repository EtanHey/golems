<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golemszikaron.compactor</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.bun/bin/bun</string>
        <string>@GOLEMS_ROOT@/packages/services/src/run-compaction.ts</string>
    </array>

    <!-- Run every hour (3600 seconds) -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/tmp/golemszikaron-compactor.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/golemszikaron-compactor.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:@HOME@/.bun/bin:/opt/homebrew/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>@GOLEMS_ROOT@</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
