<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.golemszikaron.briefing</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.bun/bin/bun</string>
        <string>@GOLEMS_ROOT@/packages/services/src/briefing.ts</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/golemszikaron-briefing.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/golemszikaron-briefing.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:@HOME@/.bun/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
