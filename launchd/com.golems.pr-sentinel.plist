<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.golems.pr-sentinel</string>
  <key>ProgramArguments</key><array>
    <string>@GOLEMS_ROOT@/scripts/pr-sentinel/pr-sentinel</string><string>scan</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>@HOME@/.local/state/golems/pr-sentinel/stdout.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/golems/pr-sentinel/stderr.log</string>
</dict></plist>
