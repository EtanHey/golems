#!/usr/bin/env python3
"""Review and lock the allowed-signers anchor, then print its pin line; run outside every agent.

Run it from the pinned tree (~/Gits/golems/.worktrees/hooks-live/scripts/golems-confirm-pin),
not a dev checkout an agent can edit."""
import runpy
import socket
import sys

# Run from hooks-live without -B: never write gate bytecode there (it turns
# install-hooks --status red, and agents may not clean it).
sys.dont_write_bytecode = True
from pathlib import Path

helper = runpy.run_path(str(Path(__file__).with_name('golems-confirm')))


def confirm(rows):
    print('These keys will be locked as the only confirmation signers:')
    for row in rows:
        print('  ' + row)
    print('Compare each SHA256 fingerprint with your signer (1Password / ssh-add -l).')
    return input('Type PIN to lock exactly these keys: ').strip() == 'PIN'


if __name__ == '__main__':
    try:
        helper['owner_terminal']()
        from tokens import pin_anchor
        fingerprint = pin_anchor(Path.home().resolve(), confirm=confirm)
        print('Confirmation anchor locked (uchg). Add this line to '
              'skills/golem-powers/human-confirm-gate/anchor.pins through a reviewed PR:')
        print(fingerprint + ' ' + socket.gethostname().split('.')[0])
        print('Tokens deny until hooks-live carries it. Never repin automatically on a mismatch.')
    except (OSError, ValueError, EOFError) as exc:
        print('golems-confirm-pin refused: ' + str(exc), file=sys.stderr)
        sys.exit(2)
