#!/usr/bin/env python3
"""Owner-only enrolment; prints public material and a pin for a separate reviewed PR."""
import hashlib
import argparse
import os
import re
import plistlib
from xml.parsers.expat import ExpatError
import stat
import sys
import subprocess
from pathlib import Path

PROFILE_SHA256 = '7287dac8a8a9b3308da5b96428471db1afb100ee6bf26250f2d5ff79082eef4f'


def read_profile(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_size > 1048576:
            raise ValueError('installed profile must be root-owned and not writable by agents')
        return stream.read(1048577)


def verified_profile(helper):
    from enclave import ENROLL_TEAM_ID
    raw = read_profile(Path(helper).parents[1] / 'embedded.provisionprofile')
    if hashlib.sha256(raw).hexdigest() != PROFILE_SHA256:
        raise ValueError('installed profile fingerprint does not match the committed pin')
    try:
        result = subprocess.run(['/usr/bin/security', 'cms', '-D', '-i', '/dev/stdin'], input=raw,
                                capture_output=True, check=True, timeout=10, env={'PATH': '/usr/bin:/bin'})
        profile = plistlib.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError, plistlib.InvalidFileException, ExpatError) as error:
        raise ValueError('installed profile entitlements could not be decoded') from error
    expected = {'com.apple.application-identifier': ENROLL_TEAM_ID + '.com.golems.approve',
                'com.apple.developer.team-identifier': ENROLL_TEAM_ID,
                'keychain-access-groups': [ENROLL_TEAM_ID + '.*']}
    if not isinstance(profile, dict) or profile.get('TeamIdentifier') != [ENROLL_TEAM_ID] or profile.get('Entitlements') != expected:
        raise ValueError('installed profile entitlements do not match the committed identity')


def verified_source(expected):
    """Owner supplies a trusted merged SHA, never an agent-selected working tree."""
    if not re.fullmatch('[0-9a-f]{40}', expected):
        raise ValueError('enrolment requires the full trusted merged commit SHA')
    repo = Path(__file__).resolve().parents[1]
    if (repo / '.git').is_symlink() or not (repo / '.git').is_dir():
        raise ValueError('enrol from a fresh standalone clone, not a worktree or linked git directory')
    env = {'PATH': '/usr/bin:/bin', 'GIT_NO_REPLACE_OBJECTS': '1', 'GIT_CONFIG_NOSYSTEM': '1',
           'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_CEILING_DIRECTORIES': str(repo.parent)}
    base = ['/usr/bin/git', '--no-replace-objects', '-c', 'core.fsmonitor=false',
            '-c', 'core.hooksPath=/dev/null', '-C', str(repo)]
    def read(*args):
        result = subprocess.run(base + list(args), check=True, capture_output=True, text=True, timeout=10, env=env)
        return result.stdout.strip()
    try:
        if read('rev-parse', '--show-toplevel') != str(repo):
            raise ValueError('enrolment repo root does not match its own script')
        if read('rev-parse', 'HEAD') != expected:
            raise ValueError('enrolment HEAD does not match the supplied merged commit')
        if read('status', '--porcelain'):
            raise ValueError('enrolment requires a clean source clone, including no untracked files')
        origin = read('remote', 'get-url', '--all', 'origin')
        if origin not in ('https://github.com/EtanHey/golems.git', 'git@github.com:EtanHey/golems.git'):
            raise ValueError('enrolment origin must be the official golems repository')
        read('merge-base', '--is-ancestor', expected, 'refs/remotes/origin/master')
    except subprocess.SubprocessError as error:
        raise ValueError('cannot verify the enrolment commit on origin/master') from error


def verified_helper():
    """Fail closed before reservation/execution; all trust inputs are committed."""
    from enclave import HELPER, ENROLL_TEAM_ID
    if not re.fullmatch('[A-Z0-9]{10}', ENROLL_TEAM_ID):
        raise ValueError('enrolment disabled: committed TEAMID placeholder needs a reviewed Team ID PR')
    helper = Path(HELPER)
    # /Applications is admin-writable. Require every component, including the
    # binary, to be root-owned and not writable by agents; disallow symlinks.
    for part in (helper, *helper.parents):
        info = part.lstat()
        expected = stat.S_ISREG if part == helper else stat.S_ISDIR
        if info.st_uid != 0 or info.st_mode & 0o022 or not expected(info.st_mode):
            raise ValueError('helper and all ancestors must be root-owned and not group/world-writable')
    if not helper.lstat().st_mode & 0o111:
        raise ValueError('root-owned helper must be executable')
    requirement = ('anchor apple generic and certificate leaf[subject.OU] = "' + ENROLL_TEAM_ID
                   + '" and identifier "com.golems.approve"')
    env = {'PATH': '/usr/bin:/bin'}
    subprocess.run(['/usr/bin/codesign', '--verify', '--strict', '-R', '=' + requirement, HELPER],
                   check=True, capture_output=True, timeout=10, env=env)
    verified_profile(HELPER)
    identities = subprocess.run(['/usr/bin/security', 'find-identity', '-p', 'codesigning', '-v'],
                                check=True, capture_output=True, text=True, timeout=10, env=env)
    if not re.fullmatch(r'\s*0 valid identities found\s*', identities.stdout):
        raise ValueError('enrolling Mac must have zero code-signing identities; keep the team key off agent Macs')
    return HELPER


# Deliberately no agent-authorized automatic provisioning. Run once after merge.
def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--commit', required=True, help='full trusted merged commit from origin/master')
    args = parser.parse_args(argv)
    # BEFORE loading any golems-confirm/enclave code from this checkout.
    verified_source(args.commit)
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader('confirm', str(Path(__file__).with_name('golems-confirm')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec); loader.exec_module(module)
    module.owner_terminal()
    from enclave import PUBLIC_KEY
    helper = verified_helper()
    target = Path.home() / PUBLIC_KEY
    # Reserve before key creation; never clobber an existing pin file.
    fd = os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        public = subprocess.run([helper, '--enroll'], check=True, capture_output=True, timeout=120).stdout
        stream.write(public); stream.flush(); os.fsync(stream.fileno())
    print(subprocess.run(['/usr/bin/openssl', 'pkey', '-pubin', '-inform', 'DER', '-in', str(target)], check=True, capture_output=True, text=True).stdout)
    print(hashlib.sha256(public).hexdigest() + ' enclave-owner')
    print('Add this pin to anchor.pins through a reviewed PR; enrolment is not activation.')

if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print('golems-enclave-enroll refused: ' + str(exc), file=sys.stderr)
        sys.exit(2)
