#!/usr/bin/env python3
"""Record an untrusted T3 option-selection receipt from a JSON file; never grant authority."""
import argparse
import json
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'skills/golem-powers/human-confirm-gate/hooks'))
from approvals import record, uuid

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['record']); parser.add_argument('--input', type=Path, required=True)
    args = parser.parse_args()
    try: print(record(json.loads(args.input.read_text())))
    except (OSError, ValueError, TypeError) as exc:
        print('golems-approval refused: ' + str(exc), file=sys.stderr); sys.exit(2)
