#!/usr/bin/env python3
"""Owner-only capability issuer; signs via a public key and SSH agent, never op."""
import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys

# Run from hooks-live without -B: never write gate bytecode there (it turns
# install-hooks --status red, and agents may not clean it).
sys.dont_write_bytecode = True
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'skills/golem-powers/human-confirm-gate/hooks'))
from commands import operations
from tokens import SSH, anchor_bytes, verify_signature


def owner_terminal():
    if any(os.environ.get(k) for k in ('CMUX_AGENT_ID', 'CLAUDE_WORKER', 'CODEX_THREAD_ID', 'CLAUDECODE', 'AI_AGENT', 'CLAUDE_CODE_SESSION_ID')) or not sys.stdin.isatty():
        raise ValueError('run in a separate interactive owner terminal, outside an agent')
    pid = os.getppid()
    login_terminal = False
    for _ in range(32):
        if pid <= 1:
            if login_terminal: return
            raise ValueError('cannot establish owner login-terminal ancestry')
        row = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'ppid=', '-o', 'comm='],
                             capture_output=True, text=True, check=True, timeout=1).stdout.strip()
        parent, name = row.split(maxsplit=1)
        if re.search(r'(?:codex|claude|cursor|repogolem)', name, re.I):
            raise ValueError('agent ancestry detected; use an owner terminal')
        login_terminal |= os.path.basename(name) in ('login', 'Terminal', 'iTerm2', 'cmux')
        pid = int(parent)
    raise ValueError('cannot establish owner terminal ancestry')


def sign(argv, **kwargs):
    return subprocess.run(argv, **kwargs)


def issue(argv=None, *, home=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo'); parser.add_argument('ref')
    parser.add_argument('action', choices=['force', 'lease', 'delete', 'rewrite', 'settings'])
    parser.add_argument('--sha'); parser.add_argument('--session', required=True)
    parser.add_argument('--remote', default='origin'); parser.add_argument('--command')
    parser.add_argument('--key', type=Path)
    parser.add_argument('--ttl', type=int, default=120)
    args = parser.parse_args(argv)
    owner_terminal()
    home = Path(home or Path.home()).resolve(); repo = str(Path(args.repo).resolve())
    if not Path(repo).is_dir() or not 1 <= args.ttl <= 300:
        raise ValueError('existing repo directory and TTL 1..300 required')
    key = args.key or home / '.config/golems/human-confirm.pub'
    if not re.match(r'^(?:ssh-|ecdsa-|sk-)[^\s]+ [A-Za-z0-9+/=]+', key.read_text()):
        raise ValueError('use a public key file backed by the owner SSH agent')
    ref = args.ref
    if args.action in ('force', 'lease', 'delete') and not ref.startswith('refs/'):
        ref = 'refs/heads/' + ref
    if args.action == 'lease':
        if not args.sha or not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', args.sha):
            raise ValueError('lease requires --sha with exact full remote SHA')
        words = ['git', 'push', f'--force-with-lease={ref}:{args.sha}', args.remote, 'HEAD:' + ref]
    elif args.action == 'force':
        words = ['git', 'push', '--force', args.remote, 'HEAD:' + ref]
    elif args.action == 'delete':
        words = ['git', 'push', '--delete', args.remote, ref]
    else:
        if not args.command:
            raise ValueError('rewrite/settings require --command with the exact tool command')
        words = []
    command = args.command or shlex.join(words)
    ops = operations(command, repo)
    def matches(op):
        targets = op.get('refs', op.get('target', []))
        targets = [targets] if isinstance(targets, str) else targets
        matched = [t == ref or t.lstrip('+').partition(':')[2] == ref for t in targets]
        if op['class'] in ('force', 'delete'):
            return bool(matched) and all(matched)
        return op.get('ref') == ref or any(matched)
    if not ops or any(op['class'] != args.action or not matches(op) for op in ops):
        raise ValueError('command does not match requested ref/action scope')
    root = home / '.config/golems/human-confirm'; root.mkdir(parents=True, mode=0o700, exist_ok=True)
    anchor = anchor_bytes(home)
    now = time.time(); nonce = uuid.uuid4().hex
    token = dict(version=1, kind='human', nonce=nonce, issued_at=now, expires_at=now + args.ttl,
                 command_sha256=hashlib.sha256((repo + '\0' + command).encode()).hexdigest(),
                 operations=ops, session_id=args.session)
    path = root / (nonce + '.json')
    raw = json.dumps(token, sort_keys=True).encode()
    print(json.dumps(dict(cwd=repo, command=command, operations=ops, session_id=args.session, ttl=args.ttl), indent=2), flush=True)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
        sign([SSH, '-Y', 'sign', '-U', '-q', '-f', str(key), '-n', 'golems-confirm', str(path)], check=True, timeout=120)
        if not verify_signature(raw, anchor, 'human', str(path) + '.sig'):
            raise ValueError('signature does not match pinned anchor')
        if time.time() >= token['expires_at']:
            raise ValueError('approval expired while signing; issue a fresh token')
    except BaseException:
        path.unlink(missing_ok=True); Path(str(path) + '.sig').unlink(missing_ok=True)
        raise
    print('Confirmation issued: ' + str(path))
    return path


if __name__ == '__main__':
    try:
        issue()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print('golems-confirm refused: ' + str(exc), file=sys.stderr)
        sys.exit(2)
