#!/usr/bin/env python3
"""Capability issuer: owner SSH agent, or native parsed-command enclave approval."""
import argparse
import base64
import hashlib
import json
import os
import re
import shlex
import stat
import subprocess
import sys

# Run from hooks-live without -B: never write gate bytecode there (it turns
# install-hooks --status red, and agents may not clean it).
sys.dont_write_bytecode = True
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'skills/golem-powers/human-confirm-gate/hooks'))
from commands import operations
from tokens import SSH, anchor_bytes, verify_signature


def owner_terminal():
    if any(os.environ.get(k) for k in ('CMUX_AGENT_ID', 'CLAUDE_WORKER', 'CODEX_THREAD_ID', 'CLAUDECODE', 'AI_AGENT', 'CLAUDE_CODE_SESSION_ID')) or not sys.stdin.isatty():
        raise ValueError('run in a separate interactive owner terminal, outside an agent')
    pid = os.getppid()
    login_terminal = False
    for _ in range(32):
        if pid <= 1:
            if login_terminal: return
            raise ValueError('cannot establish owner login-terminal ancestry')
        row = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'ppid=', '-o', 'comm='],
                             capture_output=True, text=True, check=True, timeout=1).stdout.strip()
        parent, name = row.split(maxsplit=1)
        if re.search(r'(?:codex|claude|cursor|repogolem)', name, re.I):
            raise ValueError('agent ancestry detected; use an owner terminal')
        login_terminal |= os.path.basename(name) in ('login', 'Terminal', 'iTerm2', 'cmux')
        pid = int(parent)
    raise ValueError('cannot establish owner terminal ancestry')


def sign(argv, **kwargs):
    return subprocess.run(argv, **kwargs)


# AIDEV-NOTE: `ssh-keygen -Y sign -U` asks only the agent at SSH_AUTH_SOCK; it ignores
# IdentityAgent in ~/.ssh/config. When our agent lacks the key, find the one that holds
# it and give that socket to the signing child only. The agent still prompts per request
# and the pinned-anchor verification is unchanged: this picks a socket, it grants nothing.
SSH_ADD = '/usr/bin/ssh-add'
ONEPASSWORD_AGENT = 'Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'


def agent_lists(sock, key):
    try:
        listed = subprocess.run([SSH_ADD, '-L'], env=dict(os.environ, SSH_AUTH_SOCK=str(sock)),
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return listed.returncode == 0 and any(tuple(line.split()[:2]) == key for line in listed.stdout.splitlines())


def ssh_config_words(value):
    """Split SSH arguments; a comment starts at an unquoted token boundary."""
    quote = None
    escaped = False
    for i, char in enumerate(value):
        if escaped:
            escaped = False
        elif char == '\\' and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = None
        elif char in ('"', "'"):
            quote = char
        elif char == '#' and (i == 0 or value[i - 1].isspace()):
            value = value[:i]
            break
    try:
        return shlex.split(value, comments=False)
    except ValueError:
        return []  # malformed quoting is never a socket candidate


def identity_agent(home):
    """The `Host *` IdentityAgent from ~/.ssh/config (first value wins, as in ssh), or None."""
    try:
        lines = (home / '.ssh/config').read_text(errors='replace').splitlines()
    except OSError:
        return None
    applies = True  # options before the first Host/Match apply to every host
    for line in lines:
        row = re.match(r'\s*([A-Za-z]+)(?:\s*=\s*|\s+)(.*?)\s*$', line)
        if not row or line.lstrip().startswith('#'):
            continue
        word, values = row.group(1).lower(), ssh_config_words(row.group(2))
        if word in ('host', 'match'):
            patterns = values
            applies = word == 'host' and '*' in patterns and not any(p.startswith('!') for p in patterns)
        elif word == 'identityagent' and applies:
            if len(values) != 1:
                return None
            value = values[0]
            if value.lower() == 'none' or value == 'SSH_AUTH_SOCK' or '$' in value or '%' in value:
                return None  # disabled, or an expansion we do not reimplement
            path = home / value[2:] if value.startswith('~/') else Path(value)
            return path if path.is_absolute() else None
    return None


def fingerprint(key):
    try:
        digest = hashlib.sha256(base64.b64decode(key[1], validate=True)).digest()
    except ValueError:
        return 'of an unreadable key'
    return 'SHA256:' + base64.b64encode(digest).decode().rstrip('=')


def socket_label(path, home):
    """Keep failure diagnostics copyable without disclosing absolute directories."""
    if not path:
        return '(unset)'
    path = Path(os.path.abspath(path))
    try:
        return '~/' + str(path.relative_to(home))
    except ValueError:
        return path.name


def signing_env(key_text, home):
    """None keeps our environment; else a copy whose SSH_AUTH_SOCK holds the key, for the child."""
    key = tuple(key_text.split()[:2])
    current = os.environ.get('SSH_AUTH_SOCK')
    if current and agent_lists(current, key):
        return None
    tried = [f'SSH_AUTH_SOCK {socket_label(current, home)}: key not listed']
    configured = identity_agent(home)
    candidates = [('~/.ssh/config IdentityAgent', configured)] if configured else []
    for label, path in candidates + [('1Password agent', home / ONEPASSWORD_AGENT)]:
        real = os.path.realpath(path)  # check and use the same file, not a link that can move
        try:
            info = os.stat(real)
            reason = ('not a socket' if not stat.S_ISSOCK(info.st_mode)
                      else 'owned by another user' if info.st_uid != os.getuid()
                      else None if agent_lists(real, key) else 'key not listed')
        except OSError:
            reason = 'missing'
        if reason is None:
            return dict(os.environ, SSH_AUTH_SOCK=real)
        tried.append(f'{label} {socket_label(path, home)}: {reason}')
    raise ValueError(f'no SSH agent lists the signing key {fingerprint(key)}. Tried:\n  ' + '\n  '.join(tried)
                     + '\nFix: unlock 1Password and enable its SSH agent, or set SSH_AUTH_SOCK '
                       'to the agent that holds this key.')


def issue(argv=None, *, home=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo'); parser.add_argument('ref')
    parser.add_argument('action', choices=['force', 'lease', 'delete', 'rewrite', 'settings'])
    parser.add_argument('--sha'); parser.add_argument('--session', required=True)
    parser.add_argument('--remote', default='origin'); parser.add_argument('--command')
    parser.add_argument('--key', type=Path)
    parser.add_argument('--ttl', type=int, default=120)
    parser.add_argument('--enclave', action='store_true')
    parser.add_argument('--reason', help="optional explanation, shown as the agent's unchecked words; enclave only")
    parser.add_argument('--approval-receipt', type=Path, help='recorded question-tool JSON receipt; enclave only')
    args = parser.parse_args(argv)
    if not args.enclave:
        owner_terminal()
    if args.reason is not None:
        if not args.enclave: raise ValueError('reason requires --enclave')
        from enclave import validate_reason
        validate_reason(args.reason)
    if args.approval_receipt and not args.enclave:
        raise ValueError('approval carry requires --enclave')
    home = Path(home or Path.home()).resolve(); repo = str(Path(args.repo).resolve())
    if not Path(repo).is_dir() or not 1 <= args.ttl <= 300:
        raise ValueError('existing repo directory and TTL 1..300 required')
    key = args.key or home / '.config/golems/human-confirm.pub'
    key_text = '' if args.enclave else key.read_text()
    if not args.enclave and not re.match(r'^(?:ssh-|ecdsa-|sk-)[^\s]+ [A-Za-z0-9+/=]+', key_text):
        raise ValueError('use a public key file backed by the owner SSH agent')
    ref = args.ref
    if args.action in ('force', 'lease', 'delete') and not ref.startswith('refs/'):
        ref = 'refs/heads/' + ref
    if args.action == 'lease':
        if not args.sha or not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', args.sha):
            raise ValueError('lease requires --sha with exact full remote SHA')
        words = ['git', 'push', f'--force-with-lease={ref}:{args.sha}', args.remote, 'HEAD:' + ref]
    elif args.action == 'force':
        words = ['git', 'push', '--force', args.remote, 'HEAD:' + ref]
    elif args.action == 'delete':
        words = ['git', 'push', '--delete', args.remote, ref]
    else:
        if not args.command:
            raise ValueError('rewrite/settings require --command with the exact tool command')
        words = []
    command = args.command or shlex.join(words)
    ops = operations(command, repo)
    def matches(op):
        targets = op.get('refs', op.get('target', []))
        targets = [targets] if isinstance(targets, str) else targets
        matched = [t == ref or t.lstrip('+').partition(':')[2] == ref for t in targets]
        if op['class'] in ('force', 'delete'):
            return bool(matched) and all(matched)
        return op.get('ref') == ref or any(matched)
    if not ops or any(op['class'] != args.action or not matches(op) for op in ops):
        raise ValueError('command does not match requested ref/action scope')
    # Before any token file exists: a missing agent refuses with nothing to clean up.
    child_env = None if args.enclave else signing_env(key_text, home)
    root = home / '.config/golems/human-confirm'; root.mkdir(parents=True, mode=0o700, exist_ok=True)
    anchor = anchor_bytes(home)
    now = time.time(); nonce = uuid.uuid4().hex
    token = dict(version=1, kind='human', nonce=nonce, issued_at=now, expires_at=now + args.ttl,
                 command_sha256=hashlib.sha256((repo + '\0' + command).encode()).hexdigest(),
                 operations=ops, session_id=args.session)
    path = root / (nonce + '.json')
    if args.enclave:
        import enclave
        token.update(kind='enclave', issued_at=int(now), expires_at=int(now) + args.ttl, cwd=repo, command=command,
                     **enclave.scope(command, repo, ops))
        if args.reason is not None: token['reason'] = args.reason
        if args.approval_receipt:
            from tokens import private_read
            receipt = json.loads(private_read(args.approval_receipt))
            if receipt != dict(approved=True, cwd=repo, command=command, session_id=args.session):
                raise ValueError('question-tool receipt does not match exact command/session')
            # A receipt is context, never signing authority. Spend before prompting.
            fd = os.open(str(args.approval_receipt) + '.spent', os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            os.fsync(fd); os.close(fd)
    raw = json.dumps(token, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode() if args.enclave else json.dumps(token, sort_keys=True).encode()
    print(json.dumps(dict(cwd=repo, command=command, operations=ops, session_id=args.session, ttl=args.ttl), indent=2), flush=True)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
        if args.enclave:
            # This process has no approval boolean: only a pinned signature counts.
            result = subprocess.run([enclave.HELPER], input=raw, capture_output=True, check=True, timeout=120)
            signature = Path(str(path) + '.sig')
            fd = os.open(signature, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, 'wb') as stream:
                stream.write(result.stdout); stream.flush(); os.fsync(stream.fileno())
            verified = enclave.verify(raw, home, signature)
        else:
            sign([SSH, '-Y', 'sign', '-U', '-q', '-f', str(key), '-n', 'golems-confirm', str(path)], check=True, timeout=120, env=child_env)
            verified = verify_signature(raw, anchor, 'human', str(path) + '.sig')
        if not verified:
            raise ValueError('signature does not match pinned anchor')
        if time.time() >= token['expires_at']:
            raise ValueError('approval expired while signing; issue a fresh token')
    except BaseException:
        path.unlink(missing_ok=True); Path(str(path) + '.sig').unlink(missing_ok=True)
        raise
    print('Confirmation issued: ' + str(path))
    return path


if __name__ == '__main__':
    try:
        issue()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print('golems-confirm refused: ' + str(exc), file=sys.stderr)
        sys.exit(2)
