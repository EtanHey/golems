#!/usr/bin/env bash
# Opt-in full package suite; enable repository hooks once per clone with:
#   git config core.hooksPath .githooks
# Queue through the pinned installed helper; missing coordination fails open.

set -euo pipefail
if command -v git >/dev/null; then unset $(git rev-parse --local-env-vars); fi
# heavy-suite consumes stdin to recognize delete-only pushes; preserve all refs for the ratchet.
GOLEMS_PREPUSH_UPDATES="$(cat)"
export GOLEMS_PREPUSH_UPDATES
HS="$HOME/Gits/golems/.worktrees/hooks-live/scripts/hooks/heavy-suite.py"
suite=(bash -c 'bun --no-env-file run test </dev/null && node scripts/ratchet/pre-push.mjs --ci')
if [ -f "$HS" ] && command -v python3 >/dev/null; then
  printf '%s\n' "$GOLEMS_PREPUSH_UPDATES" | GOLEMS_HEAVY_PRE_PUSH=1 python3 "$HS" -- "${suite[@]}"
else
  echo "heavy-suite: helper missing; running unqueued" >&2
  "${suite[@]}"
fi
# The installer acquires this same queue itself and refuses a nested lease.
node scripts/ratchet/pre-push.mjs --mac
