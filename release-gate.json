{
  "tagPattern": "^v?\\d+\\.\\d+\\.\\d+(?:[-+].*)?$",
  "ignorePaths": [
    "docs.local/**",
    "**/*.md",
    "collab/**"
  ],
  "repositories": {
    "EtanHey/golems": {
      "channel": "nightly",
      "artifact": { "kind": "github-release", "identifier": "golems" },
      "installCommand": "curl -fsSL https://raw.githubusercontent.com/EtanHey/golems/master/scripts/release/install.sh | sh -s -- --channel nightly"
    },
    "EtanHey/voicelayer": {
      "artifact": { "kind": "macos-app", "identifier": "VoiceBar" }
    },
    "EtanHey/cmuxlayer": {
      "artifact": { "kind": "homebrew", "identifier": "cmuxlayer" }
    },
    "EtanHey/brainlayer": {
      "artifact": { "kind": "macos-app", "identifier": "BrainBar" }
    }
  }
}
